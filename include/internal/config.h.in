/* config.h.in - Configuration header for modern Linux μEmacs */

#ifndef ΜEMACS_CONFIG_H
#define ΜEMACS_CONFIG_H

/* Package information */
#define PACKAGE_NAME "@PROJECT_NAME@"
#define PACKAGE_VERSION "@PROJECT_VERSION@"
#define PACKAGE_STRING "@PROJECT_NAME@ @PROJECT_VERSION@"
#define PACKAGE_DESCRIPTION "@PROJECT_DESCRIPTION@"

/* Version Information */
#define ΜEMACS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ΜEMACS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ΜEMACS_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define ΜEMACS_VERSION_STRING "@PROJECT_VERSION@"

/* Paths for bundled resources (built at configure time) */
/* Absolute install data dir (e.g. /usr/local/share/uemacs) */
#define UEMACS_DATA_DIR "@CMAKE_INSTALL_FULL_DATADIR@/muemacs"
/* Absolute source config dirs for in-tree runs */
/* Preferred project settings location (editor folder) */
#define UEMACS_SOURCE_EDITOR_DIR "@CMAKE_CURRENT_SOURCE_DIR@/config/editor"
/* Micro-symbol project settings dir */
#define UEMACS_SOURCE_CONFIG_DIR "@CMAKE_CURRENT_SOURCE_DIR@/config/μemacs"
/* ASCII fallback project settings dir */
#define UEMACS_SOURCE_CONFIG_DIR_ASCII "@CMAKE_CURRENT_SOURCE_DIR@/config/muemacs"

/* System headers - Linux only */
#cmakedefine HAVE_TERMIOS_H 1
#cmakedefine HAVE_SYS_IOCTL_H 1
#cmakedefine HAVE_SYS_INOTIFY_H 1
#cmakedefine HAVE_SYS_SIGNALFD_H 1
#cmakedefine HAVE_SYS_EVENTFD_H 1
#cmakedefine HAVE_SYS_TIMERFD_H 1
#cmakedefine HAVE_LINUX_IO_URING_H 1
#cmakedefine HAVE_LINUX_SECCOMP_H 1
#cmakedefine HAVE_LINUX_LANDLOCK_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_SIGNAL_H 1
#cmakedefine HAVE_LOCALE_H 1

/* Platform - Linux only now */
#define LINUX 1
#define UNIX 1
#define POSIX 1

/* Features always enabled for modern Linux */
#define UTF8 1
#define COLOR 1
#define CRYPT 1
#define MODERN 1
#define MAGIC 1
#define PKCODE 1

/* Modern Linux features */
#define TRUECOLOR 1

/* Limits */
#define MAXCOL 500
#define MAXROW 500
#define MAXWATCH 32

/* Program identification */
#define PROGNAME "μEmacs"

/* Character set */
#define ASCII 1

#endif /* ΜEMACS_CONFIG_H */
