# Maintainer: Will Clingan <wuz352@hotmail.com>
pkgname=muemacs
pkgver=3.1.0
pkgrel=1
pkgdesc="Modern C23 terminal text editor descended from Linus Torvalds' uemacs (μEmacs)"
arch=('x86_64')
# TODO(owner): set the real project URL before publishing
url="https://example.invalid/muemacs"
# License lineage vs the original MicroEMACS license is pending owner verification.
license=('GPL2')
depends=()
makedepends=('cmake>=3.20' 'gcc>=13')
# TODO(owner): point source at the real release tarball URL
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')  # Replace with actual checksum when releasing

build() {
    cd "$pkgname-$pkgver"
    cmake -S . -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j"$(nproc)"
}

check() {
    cd "$pkgname-$pkgver/build"
    ./bin/muEmacs --version
}

package() {
    cd "$pkgname-$pkgver"
    DESTDIR="$pkgdir" cmake --install build

    install -Dm644 packaging/debian/copyright \
        "$pkgdir/usr/share/licenses/$pkgname/copyright"
    install -Dm644 README.md \
        "$pkgdir/usr/share/doc/$pkgname/README.md"
}
