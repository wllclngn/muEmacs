#!/usr/bin/expect -f

# Bracketed paste smoke test using raw sequences
set timeout 10
log_user 0

set editor [lindex $argv 0]
set testfile [lindex $argv 1]
if {$editor eq ""} { set editor "./build/bin/μEmacs" }
if {$testfile eq ""} { set testfile "/tmp/paste_test.txt" }

spawn -noecho $editor $testfile
expect -timeout 5 -re ".*"

# Enter insert mode and paste literal content using bracketed paste sequences
send "i"
send -raw "\x1b\[200~"
send -raw "PASTED_CONTENT"
send -raw "\x1b\[201~"
send -raw "\x1b"  ;# exit insert
expect -timeout 5 -re ".*"

# Exit editor (C-x C-c), accept modified prompt
send -raw "\x18\x03"
expect {
    "Modified buffers exist. Leave anyway (y/n)?" { send "y\r" ; exp_continue }
    eof { }
}
exit 0
